# Caminho do arquivo SQLite onde os dados validados sao persistidos
DB_PATH=data/findata.db

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timeout (em segundos) das requisicoes HTTP
REQUEST_TIMEOUT=15

# Base da API SGS (sobrescreve o padrao; util para apontar a um fixture em teste)
# DATA_SOURCE_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.{code}/dados
