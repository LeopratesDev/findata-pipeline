# === Pipeline / banco ===
# Caminho do SQLite onde os dados validados sao persistidos.
# Local: data/findata.db · Docker: /data/findata.db (volume)
DB_PATH=data/findata.db

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timeout (em segundos) das requisicoes HTTP da coleta
REQUEST_TIMEOUT=15

# Base da API SGS (sobrescreve o padrao; util para apontar a um fixture em teste)
# DATA_SOURCE_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.{code}/dados

# === API (v2) ===
# Diretorio dos relatorios gerados. Local: reports · Docker: /reports (volume)
REPORTS_DIR=reports

# Origens permitidas no CORS (lista separada por virgula) - origem do dashboard
CORS_ORIGINS=http://localhost:8501

# Token para proteger operacoes de escrita (POST /runs). Vazio = aberto
# (aceitavel so em ambiente estritamente local). NAO comitar um token real.
API_WRITE_TOKEN=

# Rate limit do POST /runs (janela deslizante): max solicitacoes por janela
RUN_RATE_LIMIT_MAX=5
RUN_RATE_LIMIT_WINDOW_S=60

# === Dashboard (v2) ===
# URL da API usada pelo dashboard (servidor->servidor).
# Local: http://localhost:8000 · Docker: http://api:8000
API_BASE_URL=http://localhost:8000

# URL da API acessivel pelo NAVEGADOR do usuario (links de download).
# Local: http://localhost:8000 · Docker: http://localhost:8000
API_PUBLIC_URL=http://localhost:8000
